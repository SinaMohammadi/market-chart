{
  "name": "@market-chart/core",
  "version": "0.1.0",
  "description": "Framework-independent financial charting engine (Canvas 2D).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SinaMohammadi/market-chart.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/SinaMohammadi/market-chart/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/SinaMohammadi/market-chart/issues"
  },
  "keywords": [
    "chart",
    "charting",
    "financial-chart",
    "candlestick",
    "trading-chart",
    "canvas",
    "typescript",
    "charting-library",
    "technical-analysis"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js",
      "require": "./dist/static.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project core"
  },
  "publishConfig": {
    "access": "public"
  }
}
