{
  "name": "@market-chart/drawing-tools",
  "version": "0.2.0",
  "description": "Drawing tools (trend lines, Fibonacci, Gann, pitchforks, positions…) with selection, undo/redo and persistence for @market-chart/core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SinaMohammadi/market-chart.git",
    "directory": "packages/drawing-tools"
  },
  "homepage": "https://github.com/SinaMohammadi/market-chart/tree/main/packages/drawing-tools#readme",
  "bugs": {
    "url": "https://github.com/SinaMohammadi/market-chart/issues"
  },
  "keywords": [
    "chart",
    "charting",
    "financial-chart",
    "candlestick",
    "trading-chart",
    "canvas",
    "typescript",
    "drawing-tools",
    "technical-analysis"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --project drawing-tools"
  },
  "dependencies": {
    "@market-chart/core": "workspace:*"
  },
  "devDependencies": {
    "@market-chart/testing": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@market-chart/react": "workspace:*"
  },
  "peerDependencies": {
    "@market-chart/react": "workspace:>=0.1.0 <1.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@market-chart/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
