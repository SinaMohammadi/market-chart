{
  "name": "@market-chart/charts",
  "version": "0.2.0",
  "description": "Advanced chart types for @market-chart/core: Heikin-Ashi, Renko, Kagi, Point & Figure, Line Break, range/tick bars, hollow and volume candles, footprint, heatmaps, volume and market profiles, order flow.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SinaMohammadi/market-chart.git",
    "directory": "packages/charts"
  },
  "homepage": "https://github.com/SinaMohammadi/market-chart/tree/main/packages/charts#readme",
  "bugs": {
    "url": "https://github.com/SinaMohammadi/market-chart/issues"
  },
  "keywords": [
    "chart",
    "charting",
    "financial-chart",
    "candlestick",
    "trading-chart",
    "canvas",
    "typescript",
    "heikin-ashi",
    "renko",
    "market-profile",
    "footprint"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --project charts"
  },
  "dependencies": {
    "@market-chart/core": "workspace:*"
  },
  "devDependencies": {
    "@market-chart/testing": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
