{
  "name": "@market-chart/ui",
  "version": "0.1.0",
  "description": "Chart interface layer: action registry, context menus, configurable header and sidebar, settings and user preferences (headless core + React components).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SinaMohammadi/market-chart.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/SinaMohammadi/market-chart/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/SinaMohammadi/market-chart/issues"
  },
  "keywords": [
    "chart",
    "charting",
    "financial-chart",
    "candlestick",
    "trading-chart",
    "canvas",
    "typescript",
    "ui",
    "context-menu",
    "toolbar",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --project ui"
  },
  "dependencies": {
    "@market-chart/core": "workspace:*",
    "@market-chart/i18n": "workspace:*",
    "@market-chart/persistence": "workspace:*"
  },
  "devDependencies": {
    "@market-chart/drawing-tools": "workspace:*",
    "@market-chart/indicators": "workspace:*",
    "@market-chart/react": "workspace:*",
    "@market-chart/testing": "workspace:*",
    "@testing-library/react": "^16.3.0"
  },
  "peerDependencies": {
    "@market-chart/drawing-tools": "workspace:*",
    "@market-chart/indicators": "workspace:*",
    "@market-chart/react": "workspace:*",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@market-chart/drawing-tools": {
      "optional": true
    },
    "@market-chart/indicators": {
      "optional": true
    },
    "@market-chart/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
