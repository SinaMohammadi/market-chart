{
  "name": "@market-chart/i18n",
  "version": "0.2.0",
  "description": "Typed translations, locales with text direction, pluralisation, interpolation and locale-aware number/date formatting for market-chart UIs. English, Persian and Arabic built in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SinaMohammadi/market-chart.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://github.com/SinaMohammadi/market-chart/tree/main/packages/i18n#readme",
  "bugs": {
    "url": "https://github.com/SinaMohammadi/market-chart/issues"
  },
  "keywords": [
    "chart",
    "charting",
    "financial-chart",
    "candlestick",
    "trading-chart",
    "canvas",
    "typescript",
    "i18n",
    "rtl",
    "persian",
    "arabic"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --project i18n"
  },
  "dependencies": {
    "@market-chart/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
